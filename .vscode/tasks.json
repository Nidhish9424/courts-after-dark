{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Vite dev server",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*http://localhost:8443/.*"
        }
      }
    }
  ]
}
